modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33149
externalPort = 5173

[[ports]]
localPort = 35265
externalPort = 3000

[[ports]]
localPort = 36053
externalPort = 6000

[[ports]]
localPort = 40153
externalPort = 4200

[[ports]]
localPort = 42199
externalPort = 3001

[[ports]]
localPort = 44609
externalPort = 3003

[[ports]]
localPort = 44781
externalPort = 5000

[[ports]]
localPort = 45157
externalPort = 3002

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "run", "start"]
build = ["pnpm", "run", "build"]
